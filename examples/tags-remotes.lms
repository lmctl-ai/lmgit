# Tags, remotes and the origin URL.
# Run:    lmscript examples/tags-remotes.lms [repo-path]
path = ARGV.len() > 0 ? ARGV[0] : ".";

schema = load_schema(cli="lmgit" install="github:lmctl-ai/lmgit@latest");
p = _lmcode_ schema;
let repo = git.open(${path});
let tags = repo.tags();
for (i in range(0, tags.len())) {
  print("tag: " + tags.at(i));
  report.add("tag", tags.at(i), "");
}
let remotes = repo.remote_names();
for (i in range(0, remotes.len())) {
  let name = remotes.at(i);
  print("remote: " + name);
  report.add("remote", name, repo.remote_url(name));
}
report.write_text("build/tags-remotes.txt");
end _lmcode_
mkdir("build");
result = run_lmcode(p);
if (!result.ok) {
  print(json_stringify(result));
  if (result.phase == "app") { lm_exit(4); }
  lm_exit(3);
}
