# Recent commits with hash, author and date.
# Run:    lmscript examples/recent-commits.lms [repo-path] [limit]
path = ARGV.len() > 0 ? ARGV[0] : ".";
limit = ARGV.len() > 1 ? num(ARGV[1]) : 10;

schema = load_schema(cli="lmgit" install="github:lmctl-ai/lmgit@v0.2.9");
p = _lmcode_ schema;
let repo = git.open(${path});
let commits = repo.log(${limit});
for (i in range(0, commits.len())) {
  let c = commits.at(i);
  print(c.hash() + " " + c.subject() + " (@" + c.author() + ", " + c.date() + ")");
  report.add("commit", c.hash(), c.subject() + " by " + c.author());
}
report.write_text("build/recent-commits.txt");
end _lmcode_
mkdir("build");
result = run_lmcode(p);
if (!result.ok) {
  print(json_stringify(result));
  if (result.phase == "app") { lm_exit(4); }
  lm_exit(3);
}
