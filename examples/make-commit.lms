# Commits staged changes. Dry-run unless a 3rd argument is given; the
# created commit hash is printed on a live run.
# Run:    lmscript examples/make-commit.lms [repo-path] <message> [--live]
path = ARGV.len() > 0 ? ARGV[0] : ".";
message = ARGV.len() > 1 ? ARGV[1] : "chore: automated commit";
live = ARGV.len() > 2 ? ARGV[2] == "--live" : false;

schema = load_schema(cli="lmgit" install="github:lmctl-ai/lmgit@v0.2.12");
p = _lmcode_ schema;
git.dry_run(!${live});
let repo = git.open(${path});
let result = repo.commit(${message});
if (git.is_dry_run()) {
  print("dry-run: would commit with message '" + ${message} + "'");
} else {
  print("commit: " + result);
}
report.write_text("build/make-commit.txt");
end _lmcode_
mkdir("build");
result = run_lmcode(p);
if (!result.ok) {
  print(json_stringify(result));
  if (result.phase == "app") { lm_exit(4); }
  lm_exit(3);
}
