# CI gate: fails (exit 4, APP_FAIL) when the working tree has changes.
# Run:    lmscript examples/uncommitted-changes.lms [repo-path]
path = ARGV.len() > 0 ? ARGV[0] : ".";

schema = load_schema(cli="lmgit" install="github:lmctl-ai/lmgit@latest");
p = _lmcode_ schema;
let repo = git.open(${path});
let entries = repo.status();
for (i in range(0, entries.len())) {
  let e = entries.at(i);
  print("changed: " + e.path() + " [" + e.index_status() + e.work_status() + "]");
  report.add("uncommitted", e.path(), "index=" + e.index_status() + " work=" + e.work_status());
}
print("entries: " + str(entries.len()));
report.fail_if_any();
end _lmcode_
mkdir("build");
result = run_lmcode(p);
if (!result.ok) {
  print(json_stringify(result));
  if (result.phase == "app") { lm_exit(4); }
  lm_exit(3);
}
